# ---- environment ----
.venv/
__pycache__/
*.pyc
.DS_Store

# ---- corpus and shards (22 GB of raw text + 11 GB of token shards, never commit) ----
# Note the **/data/ prefix. Writing data/* only anchors to the repository root,
# while the real bulk lives under src/main/data/ -- this very nearly staged 33 GB.
**/data/corpus/
**/data/corpus_smoke/
**/data/.corpus_work/
**/data/shards/

# ---- weights and binary intermediates ----
*.pt
*.bin
*.ckpt
*.bak
*.tmp

# ---- duplicate (input.txt and tinyshakespeare.txt are byte-identical) ----
**/data/input.txt

# ---- experiment tracking ----
wandb/
runs/

# ---- deliberately kept (small, and required to reproduce) ----
# src/main/data/tok.json            465 KB  trained tokenizer, so the throughput benchmark runs out of the box
# src/main/data/sft_toy.jsonl       1.4 KB  SFT demo data
# src/main/data/tinyshakespeare.txt 1.1 MB  smoke-test corpus
# src/main/prepare.log              2.7 KB  measured mix report from the 6B-token corpus build

# ---- practice floor, kept local only ----
dojo/
